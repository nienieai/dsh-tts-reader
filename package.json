{
  "name": "dsh-tts-reader",
  "version": "0.5.4",
  "private": true,
  "description": "Read assistant replies aloud: browser voices, DeepSeek TTS, OS voices or any TTS endpoint; Host-synthesized audio is cached in memory or on disk and replayed on the next click.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.html",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "THIRD_PARTY.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tts",
    "read-aloud",
    "deepseek"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
