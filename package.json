{
  "name": "dsh-tts-studio",
  "version": "0.6.0",
  "private": false,
  "description": "Read assistant replies aloud: browser voices, DeepSeek TTS, local Piper, system voices or any TTS endpoint; Host-synthesized audio is cached in memory or on disk and replayed on the next click.",
  "license": "MIT",
  "author": "dsh-tts-studio contributors",
  "homepage": "https://github.com/nienieai/dsh-tts-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nienieai/dsh-tts-studio.git"
  },
  "bugs": {
    "url": "https://github.com/nienieai/dsh-tts-studio/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.html",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "read-aloud",
    "speech",
    "accessibility",
    "deepseek"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
